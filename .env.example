# ─────────────────────────────────────────────────────────────────────────
#  Supabase configuration (client-side, safe to expose BECAUSE of RLS).
# ─────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in your project's values.
#  Find them in the Supabase dashboard → Project Settings → API.
#
#  The anon key is designed to be public. It can ONLY read/write rows that
#  Row-Level Security allows — so make sure you've run supabase/schema.sql,
#  which enables RLS and restricts every row to its owner (user_id = auth.uid()).
#
#  The app runs fine WITHOUT these set — it just stays in local-only mode
#  (history saved to this browser's localStorage, no sign-in).

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
